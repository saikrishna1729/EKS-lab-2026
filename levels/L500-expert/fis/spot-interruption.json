{
  "description": "Send a Spot interruption notice to one Karpenter-launched instance",
  "roleArn": "arn:aws:iam::ACCOUNT_ID:role/eks-lab-fis",
  "stopConditions": [{ "source": "none" }],
  "targets": {
    "karpenterSpot": {
      "resourceType": "aws:ec2:spot-instance",
      "resourceTags": { "karpenter.sh/discovery": "eks-lab" },
      "filters": [{ "path": "State.Name", "values": ["running"] }],
      "selectionMode": "COUNT(1)"
    }
  },
  "actions": {
    "interrupt": {
      "actionId": "aws:ec2:send-spot-instance-interruptions",
      "parameters": { "durationBeforeInterruption": "PT2M" },
      "targets": { "SpotInstances": "karpenterSpot" }
    }
  },
  "tags": { "Project": "eks-lab" }
}
