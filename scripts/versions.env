# Pinned Helm chart / component versions (checked 2026-11-14).
# Bump deliberately, one at a time, and re-run the level's verify.sh.
# Find newer ones:  helm search repo <repo>/<chart> --versions | head

# L200
AWS_LBC_CHART=3.6.3                 # eks/aws-load-balancer-controller
EXTERNAL_DNS_CHART=1.23.0           # external-dns/external-dns
CERT_MANAGER_CHART=v1.21.3          # jetstack/cert-manager
GATEWAY_API_VERSION=v1.7.0          # kubernetes-sigs/gateway-api CRDs

# L300
KARPENTER_CHART=1.15.2              # oci://public.ecr.aws/karpenter/karpenter
ARGOCD_CHART=10.18.0                # argo/argo-cd (Argo CD v3.6)
ARGO_ROLLOUTS_CHART=2.43.12         # argo/argo-rollouts (v1.10)
KPS_CHART=93.3.0                    # prometheus-community/kube-prometheus-stack
TEMPO_CHART=3.2.1                   # grafana-community/tempo (single binary)
OTEL_COLLECTOR_CHART=0.178.3        # open-telemetry/opentelemetry-collector
KEDA_CHART=2.21.0                   # kedacore/keda
EXTERNAL_SECRETS_CHART=2.15.0       # external-secrets/external-secrets
VPA_CHART=5.2.0                     # fairwinds/vpa

# L400
KYVERNO_CHART=3.10.0                # kyverno/kyverno (Kyverno 1.20)
FALCO_CHART=9.2.2                   # falcosecurity/falco (optional comparison)

# L500
VELERO_CHART=12.2.5                 # vmware-tanzu/velero (Velero 1.18)
VELERO_AWS_PLUGIN=v1.14.4           # velero/velero-plugin-for-aws image tag
ISTIO_VERSION=1.30.8                # istio/base, istiod, cni, ztunnel (ambient)
OPENCOST_CHART=2.5.34               # opencost/opencost
LATTICE_CONTROLLER_CHART=v2.1.0     # oci://public.ecr.aws/aws-application-networking-k8s/aws-gateway-controller-chart
