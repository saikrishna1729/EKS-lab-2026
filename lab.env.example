# Copy to lab.env and edit. lab.env is gitignored.

# Region for the lab cluster (your CLI default is ap-southeast-1)
AWS_REGION=ap-southeast-1
# Second region, used only in L500 (DR / blue-green)
DR_REGION=ap-southeast-2

# Profile that assumes the eks-lab-admin role created by bootstrap/
# (leave empty for the one-time bootstrap, which runs as your admin identity)
AWS_PROFILE=eks-lab

CLUSTER_NAME=eks-lab

# Email for budget / alert notifications
ALERT_EMAIL=you@example.com

# Optional (L200 TLS/DNS): a domain or subdomain you control, e.g. lab.example.com
# Leave empty to use the raw ALB hostname over HTTP.
DOMAIN=

# Optional (L300 GitOps/CI): your GitHub repo for this lab, e.g. myuser/EKS-lab-2026
GITHUB_REPO=
